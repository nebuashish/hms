<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hms_ocr_form" model="ir.ui.view">
        <field name="name">hms.ocr.form</field>
        <field name="model">hms.ocr</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="processing_status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="filename" invisible="1"/>
                            <field name="handwritten_file" 
                                   filename="filename" 
                                   required="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="ocr_results" 
                               widget="text" 
                               readonly="1"
                              />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="view_hms_ocr_tree">
        <field name="name">hms.ocr.tree</field>
        <field name="model">hms.ocr</field>
        <field name="arch" type="xml">
            <list string="HMS OCR">
                <field name="filename"/>
                <field name="processing_status"/>
                <field name="ocr_results"/>
            </list>
        </field>
    </record>

    <record id="action_hms_ocr_popup" model="ir.actions.act_window">
        <field name="name">HMS OCR</field>
        <field name="res_model">hms.ocr</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hms_ocr" name="HMS OCR" sequence="260"/>

    <menuitem id="menu_hms_ocr_main" name="OCR Processing" parent="menu_hms_ocr" action="action_hms_ocr_popup" sequence="1"/>

</odoo>

